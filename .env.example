# Template. Safe to commit: every value is empty.
# Copy to .env and fill in. .env is gitignored and must never be committed.

# REQUIRED. Adaption dashboard -> API keys. Starts pt_live_ and does not expire.
ADAPTION_API_KEY=

# Optional: publishing datasets/weights to Hugging Face (export_ds.py).
# huggingface.co/settings/tokens, write scope.
HF_TOKEN=

# Optional: publishing to Kaggle.
# kaggle.com/settings -> API -> "Create New Token" downloads kaggle.json.
# Use the LEGACY 32-char key from that file. KGAT_-prefixed tokens are
# read-only and every upload returns 401.
KAGGLE_USERNAME=
KAGGLE_KEY=

# Optional and not recommended: only for `--auth login`, which exchanges these
# for a JWT valid one hour. The API key above is strictly better.
EMAIL=
PASSWORD=
